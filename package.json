{
  "name": "wp-control-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "plugin:zip": "sh scripts/plugin-zip.sh",
    "deploy": "npm run plugin:zip && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:init": "wrangler d1 execute wp-control-hub --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute wp-control-hub --local --file=schema.sql",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "node --test lib/hub.test.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "^4.164.0"
  }
}
